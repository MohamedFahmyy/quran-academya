<!-- HERO SECTION -->
<section id="home" class="hero-section py-5 py-lg-7 text-white position-relative overflow-hidden">
  <div class="hero-bg-overlay"></div>
  <div class="container position-relative z-2">
    <div class="row align-items-center g-5">
      <!-- Hero Copy -->
      <div class="col-lg-6 text-center text-lg-start">
        <div class="d-inline-flex align-items-center gap-2 badge-hero px-3 py-2 rounded-pill mb-4 border border-gold-subtle shadow-sm">
          <i class="bi bi-patch-check-fill text-accent-gold"></i>
          <span class="fw-bold fs-7 text-accent-gold-light"><%= t('hero.badge') %></span>
        </div>

        <h1 class="display-4 fw-black text-white lh-sm mb-4 hero-title">
          <%= t('hero.headline') %>
        </h1>

        <p class="lead text-white-80 mb-5 fs-5 lh-base hero-desc">
          <%= t('hero.description') %>
        </p>

        <!-- CTA Buttons -->
        <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start mb-5">
          <a href="#download" class="btn btn-gold btn-lg px-4 py-3 fw-bold d-inline-flex align-items-center gap-2 shadow-lg hover-elevate">
            <i class="bi bi-google-play fs-4"></i>
            <span><%= t('hero.ctaDownload') %></span>
          </a>
          <a href="#features" class="btn btn-outline-light btn-lg px-4 py-3 fw-bold d-inline-flex align-items-center gap-2 hover-elevate">
            <i class="bi bi-grid-fill"></i>
            <span><%= t('hero.ctaFeatures') %></span>
          </a>
        </div>

        <!-- Quick Stats Pill Grid -->
        <div class="row g-3 stats-grid">
          <div class="col-6 col-sm-3">
            <div class="stat-pill p-3 rounded-3 text-center border border-white-10 bg-white-05">
              <span class="d-block fw-black text-accent-gold fs-4">114</span>
              <span class="fs-7 text-white-70"><%= t('hero.statsSurahs') %></span>
            </div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="stat-pill p-3 rounded-3 text-center border border-white-10 bg-white-05">
              <span class="d-block fw-black text-accent-gold fs-4">6,236</span>
              <span class="fs-7 text-white-70"><%= t('hero.statsAyahs') %></span>
            </div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="stat-pill p-3 rounded-3 text-center border border-white-10 bg-white-05">
              <span class="d-block fw-black text-accent-gold fs-4">6</span>
              <span class="fs-7 text-white-70"><%= t('hero.statsLanguages') %></span>
            </div>
          </div>
          <div class="col-6 col-sm-3">
            <div class="stat-pill p-3 rounded-3 text-center border border-white-10 bg-white-05">
              <span class="d-block fw-black text-accent-gold fs-4">5</span>
              <span class="fs-7 text-white-70"><%= t('hero.statsReciters') %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero Smartphone Mockup -->
      <div class="col-lg-6 d-flex justify-content-center">
        <div class="phone-mockup-wrapper">
          <div class="phone-frame shadow-2xl">
            <!-- Speaker & Camera Notch -->
            <div class="phone-notch">
              <div class="phone-camera"></div>
              <div class="phone-speaker"></div>
            </div>

            <!-- Phone Screen Content (Home Screen) -->
            <div class="phone-screen bg-app-surface text-dark font-app">
              <!-- App Top Bar -->
              <div class="app-header d-flex justify-content-between align-items-center px-3 py-2 bg-primary text-white">
                <div class="d-flex align-items-center gap-2">
                  <div class="app-header-icon">
                    <i class="bi bi-book-half text-accent-gold"></i>
                  </div>
                  <span class="fw-bold fs-7">Al Quran Academy</span>
                </div>
                <div class="d-flex gap-2 text-white-70 fs-7">
                  <i class="bi bi-compass"></i>
                  <i class="bi bi-translate"></i>
                </div>
              </div>

              <!-- Prayer Hero Card in Mockup -->
              <div class="app-prayer-card m-3 p-3 rounded-4 text-white shadow-sm position-relative overflow-hidden">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-white-15 text-white fs-8 rounded-pill px-2 py-1">
                    <i class="bi bi-geo-alt-fill me-1"></i> <%= lang === 'ar' ? 'مكة المكرمة' : 'Makkah' %>
                  </span>
                  <span class="badge bg-gold-pill text-dark fs-8 fw-bold px-2 py-1">
                    <i class="bi bi-compass me-1"></i> 136°
                  </span>
                </div>
                <div class="text-center my-2">
                  <span class="text-white-70 fs-8 d-block"><%= lang === 'ar' ? 'الصلاة القادمة' : 'Next Prayer' %></span>
                  <h3 class="fw-extrabold text-accent-gold my-1"><%= lang === 'ar' ? 'صلاة المغرب' : 'Maghrib' %></h3>
                  <div class="fs-8 text-white-90 fw-bold letter-spacing-1">01:42:15</div>
                </div>
                <div class="d-flex justify-content-between text-center pt-2 border-top border-white-15 fs-8">
                  <div><span class="opacity-70 d-block fs-9"><%= lang === 'ar' ? 'الفجر' : 'Fajr' %></span><strong>05:04</strong></div>
                  <div><span class="opacity-70 d-block fs-9"><%= lang === 'ar' ? 'الظهر' : 'Dhuhr' %></span><strong>11:58</strong></div>
                  <div><span class="opacity-70 d-block fs-9"><%= lang === 'ar' ? 'العصر' : 'Asr' %></span><strong>15:15</strong></div>
                  <div class="text-accent-gold">
                    <span class="d-block fs-9 fw-bold"><%= lang === 'ar' ? 'المغرب' : 'Maghrib' %></span>
                    <strong>17:42</strong>
                  </div>
                  <div><span class="opacity-70 d-block fs-9"><%= lang === 'ar' ? 'العشاء' : 'Isha' %></span><strong>19:12</strong></div>
                </div>
              </div>

              <!-- Quick Launchers Grid -->
              <div class="px-3 py-1">
                <div class="row g-2 text-center">
                  <div class="col-4">
                    <div class="app-quick-btn p-2 rounded-3 bg-white shadow-2xs border">
                      <div class="quick-icon-wrap bg-primary-10 text-primary mx-auto mb-1">
                        <i class="bi bi-book"></i>
                      </div>
                      <span class="fs-8 fw-bold d-block"><%= lang === 'ar' ? 'المصحف' : 'Quran' %></span>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="app-quick-btn p-2 rounded-3 bg-white shadow-2xs border">
                      <div class="quick-icon-wrap bg-primary-10 text-primary mx-auto mb-1">
                        <i class="bi bi-moon-stars"></i>
                      </div>
                      <span class="fs-8 fw-bold d-block"><%= lang === 'ar' ? 'الأذكار' : 'Azkar' %></span>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="app-quick-btn p-2 rounded-3 bg-white shadow-2xs border">
                      <div class="quick-icon-wrap bg-primary-10 text-primary mx-auto mb-1">
                        <i class="bi bi-compass"></i>
                      </div>
                      <span class="fs-8 fw-bold d-block"><%= lang === 'ar' ? 'القبلة' : 'Qibla' %></span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Daily Verse Card -->
              <div class="m-3 p-3 bg-white rounded-4 shadow-sm border border-gold-subtle">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge bg-ivory text-primary-deep fw-bold fs-8 border border-gold-20">
                    <%= lang === 'ar' ? 'آية وتدبر' : 'Verse of the Day' %>
                  </span>
                  <span class="fs-8 text-muted">سورة البقرة: 186</span>
                </div>
                <p class="font-quran fs-7 text-center text-primary-deep my-2 lh-base">
                  ﴿ وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ﴾
                </p>
                <div class="d-flex justify-content-end text-muted fs-8">
                  <i class="bi bi-share me-2"></i>
                  <i class="bi bi-bookmark"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

