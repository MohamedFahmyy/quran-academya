<!-- READING & LISTENING SYNC SECTION -->
<section id="reading" class="py-5 py-lg-7 bg-white position-relative">
  <div class="container">
    <div class="row align-items-center g-5">
      <!-- Visual Reader Mockup -->
      <div class="col-lg-6 order-2 order-lg-1">
        <div class="reader-mockup-card p-4 rounded-5 bg-ivory border border-gold shadow-md">
          <div class="d-flex justify-content-between align-items-center pb-3 border-bottom border-gold-20 mb-3">
            <span class="fw-bold text-primary-deep fs-6">سورة الفاتحة (مكية - 7 آيات)</span>
            <span class="badge bg-primary text-white rounded-pill px-3 py-1 fs-8">الجزء 1</span>
          </div>

          <!-- Quran Verses with Active Highlight -->
          <div class="quran-verses-box py-3 font-quran text-center fs-5 lh-lg text-primary-deep">
            <p class="mb-2">بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ﴿١﴾</p>
            <div class="active-verse-highlight p-3 rounded-4 my-2 border border-gold bg-gold-subtle shadow-2xs">
              <span class="fw-bold text-primary-deep">ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ ﴿٢﴾</span>
              <div class="fs-8 text-accent-gold fw-normal mt-1">
                <i class="bi bi-volume-up-fill me-1"></i> تلاوة جارية • الشيخ عبد الرحمن السديس
              </div>
            </div>
            <p class="mb-2 opacity-75">ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ﴿٣﴾ مَـٰلِكِ يَوْمِ ٱلدِّينِ ﴿٤﴾</p>
            <p class="mb-2 opacity-50">إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ ﴿٥﴾</p>
          </div>

          <!-- Audio Player Bar Mockup -->
          <div class="player-bar-mockup p-3 rounded-4 bg-primary text-white mt-3 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-2 fs-8">
              <span>الشيخ عبد الرحمن السديس</span>
              <span class="text-accent-gold">00:14 / 00:48</span>
            </div>
            <div class="progress mb-2" style="height: 5px;">
              <div class="progress-bar bg-accent-gold" style="width: 30%"></div>
            </div>
            <div class="d-flex justify-content-center align-items-center gap-4 pt-1">
              <i class="bi bi-arrow-repeat text-white-50 fs-6"></i>
              <i class="bi bi-skip-backward-fill fs-5"></i>
              <button class="btn btn-gold btn-sm rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                <i class="bi bi-pause-fill fs-5 text-primary-deep"></i>
              </button>
              <i class="bi bi-skip-forward-fill fs-5"></i>
              <i class="bi bi-speedometer2 text-white-50 fs-6"></i>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature Description -->
      <div class="col-lg-6 order-1 order-lg-2">
        <span class="badge bg-primary-subtle text-primary border border-primary-20 px-3 py-2 rounded-pill fs-7 fw-bold mb-3">
          <%= t('reading.badge') %>
        </span>
        <h2 class="display-5 fw-extrabold text-primary-deep mb-3 section-title">
          <%= t('reading.title') %>
        </h2>
        <p class="text-muted fs-5 lh-base mb-4">
          <%= t('reading.subtitle') %>
        </p>

        <div class="d-flex flex-column gap-3">
          <div class="d-flex gap-3">
            <div class="check-icon-box bg-ivory text-accent-gold rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
              <i class="bi bi-check2-circle fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold text-primary-deep mb-1"><%= t('reading.point1Title') %></h5>
              <p class="text-muted fs-6 lh-base mb-0"><%= t('reading.point1Desc') %></p>
            </div>
          </div>

          <div class="d-flex gap-3">
            <div class="check-icon-box bg-ivory text-accent-gold rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
              <i class="bi bi-check2-circle fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold text-primary-deep mb-1"><%= t('reading.point2Title') %></h5>
              <p class="text-muted fs-6 lh-base mb-0"><%= t('reading.point2Desc') %></p>
            </div>
          </div>

          <div class="d-flex gap-3">
            <div class="check-icon-box bg-ivory text-accent-gold rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
              <i class="bi bi-check2-circle fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold text-primary-deep mb-1"><%= t('reading.point3Title') %></h5>
              <p class="text-muted fs-6 lh-base mb-0"><%= t('reading.point3Desc') %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

