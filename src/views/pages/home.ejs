      <div class="col-6 col-md-4 col-lg-2">
        <div class="p-4 rounded-4 bg-ivory border border-gold-20 shadow-2xs hover-elevate transition-all">
          <img src="/assets/images/ms.png" alt="Bahasa Melayu" width="48" height="32" class="rounded-2 shadow-2xs mb-3">
          <h6 class="fw-bold text-primary-deep mb-0"><%= t('languages.ms') %></h6>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="p-4 rounded-4 bg-ivory border border-gold-20 shadow-2xs hover-elevate transition-all">
          <img src="/assets/images/ru.png" alt="Русский" width="48" height="32" class="rounded-2 shadow-2xs mb-3">
          <h6 class="fw-bold text-primary-deep mb-0"><%= t('languages.ru') %></h6>
        </div>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="p-4 rounded-4 bg-ivory border border-gold-20 shadow-2xs hover-elevate transition-all">
          <img src="/assets/images/tr.png" alt="Türkçe" width="48" height="32" class="rounded-2 shadow-2xs mb-3">
          <h6 class="fw-bold text-primary-deep mb-0"><%= t('languages.tr') %></h6>
        </div>
      </div>
    </div>

    <p class="text-muted fs-7 mt-4">
      <i class="bi bi-info-circle me-1 text-accent-gold"></i>
      <%= t('languages.note') %>
    </p>
  </div>
</section>

<!-- DOWNLOAD CTA SECTION -->
<section id="download" class="py-5 py-lg-7 bg-primary text-white position-relative overflow-hidden text-center">
  <div class="container position-relative z-2">
    <div class="max-w-700 mx-auto">
      <div class="brand-emblem-large mb-4">
        <img src="/assets/images/logo_icon.png" alt="Al Quran Academy" width="96" height="96" class="rounded-4 shadow-lg border border-gold">
      </div>
      <span class="badge bg-white-15 text-accent-gold border border-gold-subtle px-3 py-2 rounded-pill fs-7 fw-bold mb-3">
        <%= t('download.badge') %>
      </span>
      <h2 class="display-4 fw-black text-white mb-3">
        <%= t('download.title') %>
      </h2>
      <p class="lead text-white-80 mb-5 fs-5 lh-base">
        <%= t('download.description') %>
      </p>

      <% if (config.googlePlayUrl && config.googlePlayUrl.trim() !== '') { %>
        <a href="<%= config.googlePlayUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg px-5 py-3 fw-bold d-inline-flex align-items-center gap-3 shadow-xl hover-elevate">
          <i class="bi bi-google-play fs-2"></i>
          <div class="text-start">
            <small class="d-block text-dark opacity-75 fs-8 text-uppercase">GET IT ON</small>
            <span class="fs-5 text-dark fw-extrabold"><%= t('download.btnGooglePlay') %></span>
          </div>
        </a>
      <% } else { %>
        <div class="d-inline-flex flex-column align-items-center gap-2 p-3 px-5 rounded-4 bg-white-10 border border-gold-subtle">
          <div class="d-flex align-items-center gap-3 text-accent-gold fs-5 fw-bold">
            <i class="bi bi-google-play fs-2"></i>
            <span><%= t('download.btnComingSoon') %></span>
          </div>
          <small class="text-white-60 fs-8"><%= config.packageName %></small>
        </div>
      <% } %>

      <p class="text-white-60 fs-7 mt-4 mb-0">
        <%= t('download.note') %>
      </p>
    </div>
  </div>
</section>

