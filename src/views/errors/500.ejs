<div class="error-page-container py-5 my-5 text-center">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        <div class="error-code-badge mb-3 text-danger">500</div>
        <h1 class="display-6 fw-bold text-dark-emerald mb-3">
          <%= lang === 'ar' ? 'حدث خطأ غير متوقع في الخادم' : 'Unexpected Server Error' %>
        </h1>
        <p class="lead text-muted mb-4">
          <%= lang === 'ar' 
            ? 'نعتذر عن هذا الخطأ المؤقت. نحن نعمل على معالجة المشكلة فوراً.' 
            : 'We apologize for this inconvenience. Our team has been notified and is looking into it.' %>
        </p>
        <% if (error) { %>
          <div class="alert alert-warning text-start mb-4">
            <code><%= error.message %></code>
          </div>
        <% } %>
        <div class="d-flex justify-content-center gap-3">
          <a href="/<%= lang %>" class="btn btn-emerald px-4 py-2">
            <i class="bi bi-house-door me-2"></i>
            <%= lang === 'ar' ? 'العودة للرئيسية' : 'Back to Home' %>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

