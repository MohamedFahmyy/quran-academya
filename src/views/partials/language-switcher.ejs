<% if (lang === 'ar') { %>
  <a href="/change-lang/en" class="btn btn-outline-gold btn-sm d-flex align-items-center gap-2 language-switch-btn" title="Switch to English" aria-label="Switch to English">
    <img src="/assets/images/en.png" alt="English" width="20" height="14" class="rounded-1">
    <span class="fw-bold">English</span>
  </a>
<% } else { %>
  <a href="/change-lang/ar" class="btn btn-outline-gold btn-sm d-flex align-items-center gap-2 language-switch-btn" title="التحويل إلى العربية" aria-label="التحويل إلى العربية">
    <img src="/assets/images/ar.png" alt="العربية" width="20" height="14" class="rounded-1">
    <span class="fw-bold">العربية</span>
  </a>
<% } %>

